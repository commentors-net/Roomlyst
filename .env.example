# Roomlyst Backend Environment Configuration

# Service environment: 'development' or 'production'
ENVIRONMENT=production

# Server bind settings
PORT=8000
HOST=0.0.0.0

# Database Connection (SQLite by default, or PostgreSQL for high scale)
# SQLite:
DATABASE_URL=sqlite:///./roomlyst.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/roomlyst

# Security & JWT Tokens (Generate a secure 64-char key in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Media & Storage Backend ('local' or 's3')
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage

# S3-Compatible Storage (AWS S3, MinIO, Cloudflare R2, GCP) - Optional if STORAGE_BACKEND=s3
# S3_BUCKET_NAME=roomlyst-media
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_REGION=us-east-1

# Redis Cache & Task Queue (Optional - for distributed async workers)
# REDIS_URL=redis://localhost:6379/0
